# Copie para .env e preencha. O arquivo .env NUNCA vai para o Git.

# --- Front-end (vai para o navegador: só valores públicos!) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Restrinja esta chave por domínio (HTTP referrer) no Google Cloud Console.
VITE_GOOGLE_MAPS_KEY=
# Opcional: ativa o Firebase App Check (reCAPTCHA Enterprise).
VITE_RECAPTCHA_ENTERPRISE_KEY=

# --- Funções serverless (configure no painel da Netlify, não aqui) ---
